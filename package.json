  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.7",
    "typescript": "^7.0.2",
    "vite": "^5.3.4"
  }
